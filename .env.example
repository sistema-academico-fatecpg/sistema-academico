PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
# 12.1: development | homologation | production
APP_ENV=production
# 7.4/12.1: deve permanecer false em produção (sem credencial de dev)
DEV_TEAM_PRODUCTION_ACCESS=false

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sistema_academico
DATABASE_USER=sistema_academico
# can be generated with $ openssl rand -hex 24
DATABASE_PASS=
# exemplo: postgresql://user:pass@localhost:5432/sistema_academico
DATABASE_URL=
# Base de auditoria ISOLADA (seção 10.3). Aplicar prisma/audit-database.sql.
# Obrigatória e distinta de DATABASE_URL em produção.
AUDIT_DATABASE_URL=

# can be generated with $ openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secure-secret
# 11.2.1: HTTPS obrigatório em produção
BETTER_AUTH_URL=https://localhost:3000
TLS_MIN_VERSION=1.2

RESEND_API_KEY=
# Remetente dos e-mails transacionais
EMAIL_FROM="Sistema Acadêmico <nao-responda@localhost>"
# Domínio aceito para e-mails institucionais (opcional)
INSTITUTIONAL_EMAIL_DOMAIN=

# Cofre de chaves (11.2): 32 bytes hexadecimais para AES-256-GCM.
# Gerar com: openssl rand -hex 32. Nunca versionar a chave real.
DATA_ENCRYPTION_KEY=
# Chave anterior, apenas durante rotação anual/imediata (pnpm key:rotate).
DATA_ENCRYPTION_KEY_PREVIOUS=
# 11.2.4: data da última rotação e os DOIS custodiantes nominais do cofre.
DATA_ENCRYPTION_KEY_ROTATED_AT=
KEY_CUSTODIAN_1=
KEY_CUSTODIAN_2=

# Destinos da regra 3-2-1 (11.3): HD local desconectado + nuvem exclusiva.
BACKUP_LOCAL_DIR=/mnt/backup-hd/sistema-academico
BACKUP_CLOUD_DIR=/mnt/backup-nuvem/sistema-academico
# 11.3.3: nuvem com MFA, cópias imutáveis e região. Fora do Brasil exige
# autorização de transferência internacional (LGPD art. 33).
BACKUP_CLOUD_REGION=br-sudeste
BACKUP_CLOUD_MFA=true
BACKUP_CLOUD_IMMUTABLE=true
INTERNATIONAL_TRANSFER_AUTHORIZATION=
# Ambiente SEPARADO obrigatório para o teste mensal de restauração (11.3.4).
BACKUP_TEST_DATABASE_URL=
BACKUP_OPERATOR=infraestrutura

# Chave para rotinas internas de manutenção (bootstrap, contingência, backups e
# expiração de contas Master emergenciais). Gerar com: openssl rand -hex 24
MAINTENANCE_SECRET=

# Implantação inicial: cria a primeira conta Admin Master sem senha
BOOTSTRAP_MASTER_NAME=
BOOTSTRAP_MASTER_EMAIL=

# Massa de teste (pnpm db:seed:test): um ADMIN_MASTER será criado com este
# e-mail. Coloque AQUI o seu e-mail para usar seu próprio usuário de teste.
# Se vazio, é usado um e-mail fictício coord@fatecpg.edu.br.
# A conta nasce SEM SENHA; o link de ativação é gravado em arquivo local
# protegido (TEST_DATA_OUTPUT_DIR), nunca enviado por e-mail em desenvolvimento.
TEST_EMAIL=
TEST_DATA_OUTPUT_DIR=/tmp/opencode

# Contingência (8.8): POST /api/bootstrap/master/emergency com
# x-maintenance-secret, nome/e-mail do novo Master, documento de autorização da
# direção e o ID de um Auditor ativo que registrará a solicitação.
