PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sistema_academico
DATABASE_USER=sistema_academico
# can be generated with $ openssl rand -hex 24
DATABASE_PASS=
# exemplo: postgresql://user:pass@localhost:5432/sistema_academico
DATABASE_URL=

# can be generated with $ openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secure-secret
BETTER_AUTH_URL=http://localhost:3000

RESEND_API_KEY=
# Remetente dos e-mails transacionais
EMAIL_FROM="Sistema Acadêmico <nao-responda@localhost>"
# Domínio aceito para e-mails institucionais (opcional)
INSTITUTIONAL_EMAIL_DOMAIN=
# Chave para rotinas internas de manutenção (bloqueio de conta emergencial, etc.)
MAINTENANCE_SECRET=

# Implantação inicial: cria a primeira conta Admin Master sem senha
BOOTSTRAP_MASTER_NAME=
BOOTSTRAP_MASTER_EMAIL=
