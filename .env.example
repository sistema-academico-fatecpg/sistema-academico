# ===========================================================================
# MODELO DE CONFIGURAÇÃO — copie para .env e preencha os segredos
# ===========================================================================

# --- Aplicação -------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
# 12.1: development | homologation | production
APP_ENV=production
# 7.4/12.1: deve permanecer false em produção (sem credencial de dev)
DEV_TEAM_PRODUCTION_ACCESS=false

# --- Banco de dados ---------------------------------------------------------
# Componentes base (usados pelo docker-compose para derivar as URLs dos containers).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sistema_academico
DATABASE_USER=sistema_academico
# Pode ser gerado com: openssl rand -hex 24
DATABASE_PASS=
# As URLs NÃO precisam ser declaradas: `app/lib/env/database.ts` deriva
#   DATABASE_URL             -> DATABASE_NAME
#   AUDIT_DATABASE_URL       -> DATABASE_NAME_audit (seção 10.3)
#   BACKUP_TEST_DATABASE_URL -> DATABASE_NAME_backup_test (11.3.4)
# a partir dos componentes acima. Em produção, defina explicitamente
# AUDIT_DATABASE_URL (e, se quiser, as outras) para apontar para instância e
# credenciais isoladas — valores explícitos têm precedência.

# --- Autenticação e transporte ---------------------------------------------
# Pode ser gerado com: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-secure-secret
# 11.2.1: HTTPS obrigatório em produção (use a URL pública, não 0.0.0.0/localhost).
# Em desenvolvimento local: http://localhost:3000 — o proxy não redireciona nem emite HSTS.
BETTER_AUTH_URL=https://app.example.edu
TLS_MIN_VERSION=1.2

# E-mail transacional da aplicação (ativação/redefinição em produção).
# O seed de teste NUNCA envia e-mail (ver última seção).
RESEND_API_KEY=
EMAIL_FROM="Sistema Acadêmico <nao-responda@localhost>"

# --- Cofre de chaves (11.2) -------------------------------------------------
# 32 bytes hexadecimais (openssl rand -hex 32). Nunca versionar a chave real.
DATA_ENCRYPTION_KEY=
# Chave anterior, apenas durante rotação anual/imediata (pnpm key:rotate).
DATA_ENCRYPTION_KEY_PREVIOUS=
# 11.2.4: data da última rotação e os DOIS custodiantes nominais do cofre.
DATA_ENCRYPTION_KEY_ROTATED_AT=
KEY_CUSTODIAN_1=
KEY_CUSTODIAN_2=

# --- Backups (11.3) ---------------------------------------------------------
# Destinos da regra 3-2-1: HD local desconectado + nuvem exclusiva.
BACKUP_LOCAL_DIR=/mnt/backup-hd/sistema-academico
BACKUP_CLOUD_DIR=/mnt/backup-nuvem/sistema-academico
# 11.3.3: nuvem com MFA, cópias imutáveis e região. Fora do Brasil exige
# autorização de transferência internacional (LGPD art. 33).
BACKUP_CLOUD_REGION=br-sudeste
BACKUP_CLOUD_MFA=true
BACKUP_CLOUD_IMMUTABLE=true
INTERNATIONAL_TRANSFER_AUTHORIZATION=
BACKUP_OPERATOR=infraestrutura
AUDIT_ARCHIVE_DIR=/mnt/audit-archive

# Rotinas internas de manutenção (bootstrap, contingência, backups, expiração).
# Gerar com: openssl rand -hex 24
MAINTENANCE_SECRET=

# ===========================================================================
# DESENVOLVIMENTO / TESTE — remover ou deixar vazio em produção
# ===========================================================================

# Fallback do domínio institucional para perfis criados em runtime sem domínio próprio.
# Vazio = academico.com (os seis perfis fixos já têm domínio por cargo).
INSTITUTIONAL_EMAIL_DOMAIN=
# Contato do DPO exibido no aviso de privacidade (valor padrão no código).
DPO_EMAIL=

# Primeira conta Master (bootstrap manual, sem senha).
# O e-mail é o PESSOAL (destinatário do link); o institucional é gerado pelo banco.
BOOTSTRAP_MASTER_NAME=
BOOTSTRAP_MASTER_EMAIL=

# Massa de teste (pnpm db:seed:test): 3 Masters, 1 secretaria, 2 professores e
# 40 alunos. NENHUM e-mail é enviado: links/códigos vão para o arquivo local e
# para o console. TEST_EMAIL é o único e-mail real, usado pelo primeiro Master
# para verificação manual; os demais usam @ficticio.local.
TEST_EMAIL=
TEST_DATA_OUTPUT_DIR=/tmp/opencode
# Dono dos arquivos de ativação gravados pelo container (host Unix).
HOST_UID=1000
HOST_GID=1000

# Diagnóstico TOTP temporário (desligar após investigação).
TOTP_DEBUG_LOGS=0
