// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN_MASTER
  ADMIN_SECUNDARIO
  PROFESSOR
  ALUNO
  AUDITOR
  SUPORTE_TECNICO
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  BLOCKED
  INACTIVE
}

enum TokenPurpose {
  ACCOUNT_ACTIVATION
  EMAIL_CONFIRMATION
  PASSWORD_RESET
}

enum SystemModule {
  USERS
  COURSES
  PERIODS
  SUBJECTS
  ENROLLMENTS
  GRADES
  AUDIT_LOGS
  BACKUPS
}

enum OperationResult {
  SUCCESS
  FAILURE
}

enum SupportAccessStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  users       User[]
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id            Int    @id @default(autoincrement())
  name          String @unique
  description   String?
  roles         RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                String     @id @default(uuid())
  name              String
  socialName        String?    @map("social_name")
  email             String     @unique
  institutionalEmail String   @unique @map("institucional_email")
  registrationNumber String?   @unique @map("registration_number")
  passwordHash      String     @map("password_hash")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaSecret         String?    @map("mfa_secret")
  status            AccountStatus @default(PENDING_ACTIVATION)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  roleId            String?    @map("role_id")
  role              Role?      @relation(fields: [roleId], references: [id])
  userRoles         UserRole[]
  tokens            Token[]
  mfaRecoveryCodes  MfaRecoveryCode[]
  supportAccess     SupportAccessGrant[]
  requestedSupportAccess SupportAccessGrant[] @relation("RequestedBy")
  approvedSupportAccess SupportAccessGrant[] @relation("ApprovedBy")
  requestedOperations CriticalOperationRequest[] @relation("RequestedOperations")
  approvedOperations CriticalOperationRequest[] @relation("ApprovedOperations")
  executedOperations CriticalOperationRequest[] @relation("ExecutedOperations")
  logs              Log[]
  enrollments       Enrollment[]
  recordedGrades    Grade[]   @relation("recordedByUser")

  @@map("users")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Token {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  purpose   TokenPurpose
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("tokens")
}

model MfaRecoveryCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   @map("code_hash")
  createdAt DateTime @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

model SupportAccessGrant {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedBy String
  requestedByUser User @relation("RequestedBy", fields: [requestedBy], references: [id])
  approvedBy  String?
  approvedByUser User? @relation("ApprovedBy", fields: [approvedBy], references: [id])
  reason      String
  status      SupportAccessStatus @default(PENDING)
  startsAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now()) @map("created_at")
  modules     SupportAccessModule[]

  @@index([userId, status])
  @@map("support_access_grants")
}

model SupportAccessModule {
  grantId String
  grant   SupportAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  module  SystemModule

  @@id([grantId, module])
  @@map("support_access_modules")
}

model CriticalOperationRequest {
  id           String   @id @default(uuid())
  requestedBy  String
  requestedByUser User @relation("RequestedOperations", fields: [requestedBy], references: [id])
  approvedBy   String?
  approvedByUser User? @relation("ApprovedOperations", fields: [approvedBy], references: [id])
  operation    String
  module       SystemModule?
  recordType   String?
  recordId     String?
  reason       String
  status       ApprovalStatus @default(PENDING)
  requestedAt  DateTime @default(now()) @map("requested_at")
  decidedAt    DateTime? @map("decided_at")
  executedAt   DateTime? @map("executed_at")
  executedBy   String?
  executedByUser User? @relation("ExecutedOperations", fields: [executedBy], references: [id])

  @@index([requestedBy, status])
  @@index([approvedBy, status])
  @@map("critical_operation_requests")
}

model Log {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role         RoleName?
  ipAddress    String   @map("ip_address")
  action       String
  module       SystemModule
  recordType   String?  @map("record_type")
  recordId     String?  @map("record_id")
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  result       OperationResult
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([module, action])
  @@index([createdAt])
  @@map("logs")
}

model Course {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  periods     Period[]
  subjects    Subject[]

  @@map("courses")
}

model Period {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(false) @map("is_active")
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id])
  subjects    Subject[]

  @@index([courseId])
  @@index([isActive])
  @@map("periods")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id])
  periodId    String   @map("period_id")
  period      Period   @relation(fields: [periodId], references: [id])
  enrollments Enrollment[]

  @@index([courseId])
  @@index([periodId])
  @@map("subjects")
}

model Enrollment {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String   @map("subject_id")
  subject     Subject  @relation(fields: [subjectId], references: [id])
  enrolledAt  DateTime @default(now()) @map("enrolled_at")
  status      String   @default("ACTIVE") @map("status") // ACTIVE, COMPLETED, CANCELLED, DP (dependência)
  finalGrade  Decimal? @map("final_grade")
  grades      Grade[]

  @@index([studentId])
  @@index([subjectId])
  @@index([status])
  @@map("enrollments")
}

model Grade {
  id          String   @id @default(uuid())
  enrollmentId String   @map("enrollment_id")
  enrollment  Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  value       Decimal  @map("value") // 0 a 10
  type        String   @default("EXAM") // EXAM, PROJECT, PARTICIPATION, RECOVERY
  recordedAt  DateTime @default(now()) @map("recorded_at")
  recordedBy  String   @map("recorded_by")
  recordedByUser User?   @relation("recordedByUser", fields: [recordedBy], references: [id])

  @@index([enrollmentId])
  @@index([recordedBy])
  @@map("grades")
}